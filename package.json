{
  "name": "smartqueue-project",
  "version": "1.0.0",
  "private": true,
  "description": "SmartQueue – Queue Token Management System",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n \"backend,frontend\" -c \"cyan,magenta\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "start": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm --prefix backend start\" \"npm --prefix frontend preview\"",
    "start:backend": "npm --prefix backend start",
    "seed:backend": "npm --prefix backend run seed",
    "test:backend": "node backend/src/utils/testEndpoints.js",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
