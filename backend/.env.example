# SmartQueue Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Server Port
PORT=5001

# MongoDB Connection String (e.g., local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/smartqueue_db

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Environment Mode (development | production | test)
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Optional Google Gemini AI API Key (Leave empty to use unlimited built-in queue AI engine)
GEMINI_API_KEY=your_gemini_api_key_here_or_leave_blank_for_unlimited_mode

